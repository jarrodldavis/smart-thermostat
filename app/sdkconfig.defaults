# Shared thermostat configuration for ESP-IDF 5.4 / PlatformIO Espressif32 6.10.
# Commit intentional settings here; sdkconfig.<environment> is generated.

# Board: ESP32-S3, 16 MB flash, 80 MHz DIO, external PSRAM disabled.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_SPIRAM=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# PlatformIO's board_build.partitions selects the actual CSV.
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Local diagnostics and flash core dumps.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
CONFIG_LOG_COLORS=y
CONFIG_FREERTOS_ISR_STACKSIZE=2096
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
# Use the crashed task's stack when writing the core dump.
CONFIG_ESP_COREDUMP_STACK_SIZE=0
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=n
CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=n

# Opt in to BLE provisioning by enabling Bluetooth and the NimBLE host.
CONFIG_BT_ENABLED=n
# When BLE is enabled, provision one phone as a peripheral. Allow one
# advertising activity alongside the connection; no central/scanning roles.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Bound packet pools for the single provisioning connection.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=2
# Keep one slot for the SDK's local privacy key; provisioning does not bond
# or restore saved subscriptions between BLE connections.
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=0

# Existing application networking and HTTP limits.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_LWIP_DHCP_OPTIONS_LEN=69
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# Preserve the HTTPS behavior introduced in commit 5551fc4.
# These settings permit the existing client to skip server certificate checks.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
