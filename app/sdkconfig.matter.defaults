# Retain SoftAP so provisioning can be tested alongside Matter.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ENABLE_TEST_SETUP_PARAMS=y
CONFIG_EXAMPLE_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_EXAMPLE_DAC_PROVIDER=y

# Connectivity tests use one thermostat endpoint with external PSRAM disabled.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_ENABLE_OPENTHREAD=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ENABLE_ESP_INSIGHTS_TRACE=n
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ENABLE_CHIPOBLE=y

# Reclaim internal RAM for Matter, BLE, the touchscreen and the HTTP server.
# Prefer lower Wi-Fi throughput over reserving RAM for high-rate traffic.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Allocate Matter session/read-handler objects when used, rather than reserving
# all pool entries alongside the display and application task stacks at boot.
CONFIG_CHIP_SYSTEM_CONFIG_POOL_USE_HEAP=y
# Bound TCP bursts to two 1440-byte segments on this internal-RAM-only profile.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_RECVMBOX_SIZE=4

# Keep the root-node and thermostat clusters; omit unrelated device types.
CONFIG_SUPPORT_ACCESS_CONTROL_CLUSTER=y
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_ADMINISTRATOR_COMMISSIONING_CLUSTER=y
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BASIC_INFORMATION_CLUSTER=y
CONFIG_SUPPORT_BINDING_CLUSTER=y
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
